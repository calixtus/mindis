<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- The board fills the pane; the add button floats over it, pinned top-right,
     overlapping the widgets rather than sitting in its own toolbar strip. -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.mindis.gui.dashboard.DashboardController"
           stylesheets="@dashboard.css"
           styleClass="dashboard">

    <ScrollPane fx:id="boardScroll" fitToWidth="true" styleClass="dashboard-scroll">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>
    </ScrollPane>

    <MenuButton fx:id="addWidgetButton" text="%Add widget" styleClass="dashboard-add-button"
                StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="12" right="24"/>
        </StackPane.margin>
        <graphic>
            <FontIcon iconLiteral="mdi2p-plus"/>
        </graphic>
    </MenuButton>
</StackPane>
